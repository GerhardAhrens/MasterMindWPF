<base:UserControlBase
    x:Class="MasterMindWPF.Beispiele.MasterMindUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MasterMindWPF.Beispiele"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="500"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Resources/Style/WoodTexture.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        ClipToBounds="True"
        ColumnDefinitions="*,120,2*,1*,*"
        RowDefinitions="Auto,40,*,30"
        ShowGridLines="True">
        <Control
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Style="{StaticResource ResourceKey=AnimatedWoodControlStyle}" />

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="28"
            FontWeight="Bold"
            Text="Master Mind" />

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="1">
            <UniformGrid Columns="6" Rows="1">
                <local:EllipseButton
                    x:Name="SelectR0C1"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R0:C1" />

                <local:EllipseButton
                    x:Name="SelectR0C2"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R0:C2" />

                <local:EllipseButton
                    x:Name="SelectR0C3"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R0:C3" />

                <local:EllipseButton
                    x:Name="SelectR0C4"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R0:C4" />

                <local:EllipseButton
                    x:Name="SelectR0C5"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R0:C5" />

                <local:EllipseButton
                    x:Name="SelectR0C6"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R0:C6" />

            </UniformGrid>
        </Border>

        <local:EllipseButton
            x:Name="ebCheck"
            Grid.Row="1"
            Grid.Column="3"
            Width="40"
            Height="40"
            Command="{Binding Path=CheckCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
            Cursor="Hand"
            FillColor="DodgerBlue"
            Text="Ok" />


        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Vertical">
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Content="Neues Spiel" />

            <Button
                Width="100"
                Height="30"
                Margin="5"
                Content="Auflösen" />

            <Button
                Width="100"
                Height="30"
                Margin="5"
                Content="Spiel Historie" />

        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="1">
            <UniformGrid Columns="4" Rows="10">
                <!--  Reihe 1  -->
                <local:EllipseButton
                    x:Name="PlayerR1C1"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R1:C1" />

                <local:EllipseButton
                    x:Name="PlayerR1C2"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R1:C2" />

                <local:EllipseButton
                    x:Name="PlayerR1C3"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R1:C2" />

                <local:EllipseButton
                    x:Name="PlayerR1C4"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R1:C4" />

                <!--  Reihe 2  -->
                <local:EllipseButton
                    x:Name="PlayerR2C1"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R2:C1" />

                <local:EllipseButton
                    x:Name="PlayerR2C2"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R2:C2" />

                <local:EllipseButton
                    x:Name="PlayerR2C3"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R2:C2" />

                <local:EllipseButton
                    x:Name="PlayerR2C4"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R2:C4" />

                <!--  Reihe 3  -->
                <local:EllipseButton
                    x:Name="PlayerR3C1"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R3:C1" />

                <local:EllipseButton
                    x:Name="PlayerR3C2"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R3:C2" />

                <local:EllipseButton
                    x:Name="PlayerR3C3"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R3:C3" />

                <local:EllipseButton
                    x:Name="PlayerR3C4"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R3:C4" />

                <!--  Reihe 4  -->
                <local:EllipseButton
                    x:Name="PlayerR4C1"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R4:C1" />

                <local:EllipseButton
                    x:Name="PlayerR4C2"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R4:C2" />

                <local:EllipseButton
                    x:Name="PlayerR4C3"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R4:C3" />

                <local:EllipseButton
                    x:Name="PlayerR4C4"
                    Width="25"
                    Height="25"
                    Command="{Binding Path=PlayerColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    FillColor="Transparent"
                    TagContent="Select:R4:C4" />
            </UniformGrid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="3"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="1">
            <UniformGrid Columns="4" Rows="10">
                <!--  Reihe 1  -->
                <Ellipse
                    x:Name="ResultR1C1"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR1C2"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR1C3"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR1C4"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <!--  Reihe 2  -->
                <Ellipse
                    x:Name="ResultR2C1"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR2C2"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR2C3"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR2C4"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

            </UniformGrid>
        </Border>

    </Grid>
</base:UserControlBase>
