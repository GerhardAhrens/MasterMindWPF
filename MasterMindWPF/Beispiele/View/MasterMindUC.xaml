<base:UserControlBase
    x:Class="MasterMindWPF.Beispiele.MasterMindUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MasterMindWPF.Beispiele"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="500"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Resources/Style/WoodTexture.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        ClipToBounds="True"
        ColumnDefinitions="*,120,2*,1*,*"
        RowDefinitions="Auto,40,*,30"
        ShowGridLines="True">
        <Control
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Style="{StaticResource ResourceKey=AnimatedWoodControlStyle}" />

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="5"
            Margin="0,10,0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="28"
            FontWeight="Bold"
            Text="Master Mind" />

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="1">
            <UniformGrid Columns="6" Rows="1">
                <local:EllipseButton
                    x:Name="SelectR1C1"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Command="{Binding Path=SelectColorCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Ellipse}}"
                    Cursor="Hand"
                    TagContent="Select:R1:C1" />

                <!--
                <Ellipse
                    x:Name="SelectR1C1"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Cursor="Hand"
                    Fill="Transparent"
                    IsEnabled="True"
                    Stroke="Gray" />
                -->

                <Ellipse
                    x:Name="SelectR1C2"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Cursor="Hand"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="SelectR1C3"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Cursor="Hand"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="SelectR1C4"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Cursor="Hand"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="SelectR1C5"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Cursor="Hand"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="SelectR1C6"
                    Width="25"
                    Height="25"
                    Margin="5"
                    Cursor="Hand"
                    Fill="Transparent"
                    Stroke="Gray" />

            </UniformGrid>
        </Border>


        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Vertical">
            <Button
                Width="100"
                Height="30"
                Margin="5"
                Content="Neues Spiel" />

            <Button
                Width="100"
                Height="30"
                Margin="5"
                Content="Auflösen" />

            <Button
                Width="100"
                Height="30"
                Margin="5"
                Content="Spiel Historie" />

        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="1">
            <UniformGrid Columns="4" Rows="10">
                <Ellipse
                    x:Name="PlayerR1C1"
                    Width="30"
                    Height="30"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="PlayerR1C2"
                    Width="30"
                    Height="30"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="PlayerR1C3"
                    Width="30"
                    Height="30"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="PlayerR1C4"
                    Width="30"
                    Height="30"
                    Fill="Transparent"
                    Stroke="Gray" />
            </UniformGrid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="3"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="1">
            <UniformGrid Columns="4" Rows="10">
                <Ellipse
                    x:Name="ResultR1C1"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR1C2"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR1C3"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />

                <Ellipse
                    x:Name="ResultR1C4"
                    Width="15"
                    Height="15"
                    Margin="5"
                    Fill="Transparent"
                    Stroke="Gray" />
            </UniformGrid>
        </Border>

    </Grid>
</base:UserControlBase>
