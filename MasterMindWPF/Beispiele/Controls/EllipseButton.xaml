<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MasterMindWPF.Beispiele">

    <Style TargetType="{x:Type local:EllipseButton}">

        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="120" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EllipseButton}">

                    <Grid>

                        <Ellipse
                            x:Name="PART_Ellipse"
                            Fill="{TemplateBinding FillColor}"
                            Stroke="{TemplateBinding BorderColor}"
                            StrokeThickness="{TemplateBinding BorderWidth}"
                            Tag="{TemplateBinding TagContent}" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{TemplateBinding Text}" />

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>